<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reminders - ExpiryRemind</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --sidebar-width: 260px; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; }
        .sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; background: white; padding: 2rem 1rem; border-right: 1px solid #e5e7eb; }
        .nav-link { padding: .9rem 1rem; border-radius: 14px; color: #64748b; display: flex; gap: 12px; align-items: center; text-decoration: none; position: relative; }
        .nav-link.active { background: linear-gradient(135deg,#6366f1,#818cf8); color: white; }
        
        .badge-wa {
            position: absolute; right: 15px; background: #25D366; color: white;
            font-size: 0.7rem; padding: 2px 7px; border-radius: 50px; font-weight: 700;
        }

        .main-content { margin-left: var(--sidebar-width); padding: 2.5rem; }
        .timeline-section { margin-bottom: 2rem; }
        .timeline-header { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; }
        
        .reminder-card {
            background: white; border-radius: 18px; padding: 1.2rem; margin-bottom: 10px;
            border-left: 5px solid #cbd5e1; display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }
        .urgent { border-left-color: #ef4444; background: #fff5f5; }
        .warning { border-left-color: #f59e0b; background: #fffbeb; }
    </style>
</head>
<body>

<nav class="sidebar">
    <div class="d-flex align-items-center mb-5 px-3">
        <h5 class="fw-bold mb-0 text-primary">ExpiryRemind</h5>
    </div>
    <div class="nav flex-column">
        <a href="/dashboard" class="nav-link"><i class="bi bi-grid"></i>Dashboard</a>
        
        <% if (locals.user) { %>
            <a href="/my-products" class="nav-link"><i class="bi bi-box-seam"></i>My Products</a>
            <a href="/categories" class="nav-link"><i class="bi bi-tags"></i>Categories</a>
            <a href="/reminders" class="nav-link active">
                <i class="bi bi-bell"></i>Reminders 
                <% if (totalAlerts > 0) { %>
                    <span class="badge-wa"><%= totalAlerts %></span>
                <% } %>
            </a>
            <hr>
            <a href="/logout" class="nav-link text-danger"><i class="bi bi-box-arrow-left"></i>Logout</a>
        <% } else { %>
            <a href="/login" class="nav-link"><i class="bi bi-box-arrow-in-right"></i>Login</a>
        <% } %>
    </div>
</nav>

<main class="main-content">
    <h2 class="fw-bold mb-4">Expiry Alerts</h2>

    <div class="timeline-section">
        <div class="timeline-header text-danger"><i class="bi bi-exclamation-octagon-fill"></i> Expiring Today</div>
        <div id="todayList">
            <% if (expiringToday.length > 0) { %>
                <% expiringToday.forEach(p => { %>
                    <div class="reminder-card urgent">
                        <div>
                            <h6 class="fw-bold mb-0"><%= p.name %></h6>
                            <small class="text-muted">Consume immediately!</small>
                        </div>
                        <span class="badge bg-danger">Urgent</span>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-muted small">No items expiring today.</p>
            <% } %>
        </div>
    </div>

    <div class="timeline-section">
        <div class="timeline-header text-warning"><i class="bi bi-clock-history"></i> Expiring This Week</div>
        <div id="weekList">
            <% if (expiringThisWeek.length > 0) { %>
                <% expiringThisWeek.forEach(p => { %>
                    <div class="reminder-card warning">
                        <div>
                            <h6 class="fw-bold mb-0"><%= p.name %></h6>
                            <small class="text-muted">Expires on <%= new Date(p.expiryDate).toLocaleDateString() %></small>
                        </div>
                        <span class="badge bg-warning text-dark">Coming Up</span>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-muted small">All good for this week!</p>
            <% } %>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>