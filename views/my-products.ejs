<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Products - ExpiryRemind</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root { --sidebar-width: 260px; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
    }

    .sidebar {
      width: var(--sidebar-width);
      height: 100vh;
      position: fixed;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(14px);
      padding: 2rem 1rem;
      border-right: 1px solid #e5e7eb;
    }

    .logo-box {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      box-shadow: 0 8px 20px rgba(99,102,241,0.4);
    }

    .nav-link {
      padding: .9rem 1rem;
      border-radius: 14px;
      color: #64748b;
      display: flex;
      gap: 12px;
      align-items: center;
      text-decoration: none;
    }

    .nav-link.active {
      background: linear-gradient(135deg, #6366f1, #818cf8);
      color: white;
    }

    .main-content {
      margin-left: var(--sidebar-width);
      padding: 2.5rem;
    }

    .product-card-item {
      background: white;
      border-radius: 20px;
      padding: 1.2rem;
      margin-bottom: 1rem;
      border: 1px solid rgba(0,0,0,0.05);
      display: flex;
      align-items: center;
      transition: .3s;
    }

    .product-card-item:hover {
      transform: scale(1.01);
      box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .cat-badge {
      font-size: .75rem;
      padding: 5px 12px;
      border-radius: 10px;
      font-weight: 600;
    }

    .status-expired { color: #ef4444; background: #fee2e2; }
    .status-safe { color: #10b981; background: #d1fae5; }

    .action-btn {
      width: 35px;
      height: 35px;
      border-radius: 10px;
      border: none;
      background: #f1f5f9;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .action-btn:hover {
      background: #e2e8f0;
      color: #1e293b;
    }

    /* Recipe Button - Green */
    .recipe-btn {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
    }
    .recipe-btn:hover {
      background: linear-gradient(135deg, #059669, #047857);
      color: white;
    }

    /* Buy Button - Orange */
    .buy-btn {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
    }
    .buy-btn:hover {
      background: linear-gradient(135deg, #d97706, #b45309);
      color: white;
    }

    /* Modal styles */
    .modal-content {
      border-radius: 20px;
      border: none;
    }
    .modal-header {
      border-bottom: 1px solid #e5e7eb;
      border-radius: 20px 20px 0 0;
    }
    .link-card {
      background: #f8fafc;
      padding: 1rem;
      border-radius: 12px;
      margin-bottom: 0.5rem;
      transition: .2s;
      text-decoration: none;
      display: block;
      color: inherit;
    }
    .link-card:hover {
      background: #e2e8f0;
      transform: translateX(5px);
    }
    .recipe-content {
      line-height: 1.8;
      font-size: 15px;
    }
    .recipe-content p {
      margin-bottom: 1rem;
    }
  </style>
</head>

<body>

<nav class="sidebar">
  <div class="d-flex align-items-center mb-5 px-3">
    <div class="logo-box text-white rounded-3 p-2 me-2">
      <i class="bi bi-calendar2-check-fill"></i>
    </div>
    <h5 class="fw-bold mb-0">ExpiryRemind</h5>
  </div>

  <div class="nav flex-column">
    <a href="/dashboard" class="nav-link"><i class="bi bi-grid"></i>Dashboard</a>
    <a href="/my-products" class="nav-link active"><i class="bi bi-box-seam"></i>My Products</a>
    <a href="/categories" class="nav-link"><i class="bi bi-tags"></i>Categories</a>
    <hr>
    <a href="/logout" class="nav-link text-danger"><i class="bi bi-box-arrow-left"></i>Logout</a>
  </div>
</nav>

<main class="main-content">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Inventory</h2>
      <p class="text-muted">
        Total <%= products ? products.length : 0 %> products found
      </p>
    </div>

    <a href="/add-product" class="btn btn-primary px-4 py-2 text-white">
      <i class="bi bi-plus-lg me-2"></i>Add
    </a>
  </div>

  <% if (!products || products.length === 0) { %>
    <p class="text-muted">No products added yet.</p>
  <% } %>

  <% products && products.slice().reverse().forEach(p => { 
      const expiryDate = new Date(p.expiryDate);
      const isExpired = expiryDate < new Date();
  %>

  <div class="product-card-item">
    <div class="flex-grow-1">
      <h6 class="fw-bold mb-1"><%= p.name %></h6>
      <span class="cat-badge bg-light text-muted">
        <%= p.category || "Other" %>
      </span>
    </div>

    <div class="me-4 text-center">
      <small class="text-muted d-block">Expiry</small>
      <span class="fw-semibold <%= isExpired ? 'text-danger' : '' %>">
        <%= expiryDate.toLocaleDateString() %>
      </span>
    </div>

    <div class="me-4">
      <span class="cat-badge <%= isExpired ? 'status-expired' : 'status-safe' %>">
        <%= isExpired ? "Expired" : "Safe" %>
      </span>
    </div>

    <div class="d-flex gap-2">
      <!-- Recipe/Info Button (Green) -->
      <button 
        class="action-btn recipe-btn" 
        onclick="getRecipe('<%= p.category %>', '<%= p.name %>')"
        title="Get Recipe/Info">
        <i class="bi bi-book"></i>
      </button>

      <!-- Buy Online Button (Orange) -->
      <button 
        class="action-btn buy-btn" 
        onclick="getBuyLinks('<%= p.category %>', '<%= p.name %>')"
        title="Buy Online">
        <i class="bi bi-cart3"></i>
      </button>

      <!-- Edit Button -->
      <a href="/products/edit/<%= p._id %>" class="action-btn" title="Edit">
        <i class="bi bi-pencil"></i>
      </a>

      <!-- Delete Button -->
      <form action="/products/<%= p._id %>?_method=DELETE" method="POST" style="display: inline;">
        <button class="action-btn text-danger" title="Delete" type="submit">
          <i class="bi bi-trash"></i>
        </button>
      </form>
    </div>
  </div>

  <% }) %>

</main>

<!-- Recipe/Info Modal -->
<div class="modal fade" id="recipeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">
          <i class="bi bi-book me-2 text-success"></i>
          <span id="recipeTitle">Recipe & Information</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="recipeContent" class="p-3">
          <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Fetching information...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Buy Links Modal -->
<div class="modal fade" id="buyLinksModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">
          <i class="bi bi-cart3 me-2 text-warning"></i>
          <span id="buyTitle">Buy Online</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="buyLinksContent">
          <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Getting shopping links...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
console.log('✅ My Products page loaded');

// Get Recipe/Info from Gemini
async function getRecipe(category, productName) {
  console.log('📚 Fetching recipe for:', productName, category);
  
  const modal = new bootstrap.Modal(document.getElementById('recipeModal'));
  const titleEl = document.getElementById('recipeTitle');
  const contentEl = document.getElementById('recipeContent');

  // Set title and show loading
  titleEl.textContent = productName;
  contentEl.innerHTML = `
    <div class="text-center py-5">
      <div class="spinner-border text-success" role="status"></div>
      <p class="mt-3 text-muted">Generating content...</p>
    </div>
  `;

  modal.show();

  try {
    const res = await fetch('/api/gemini/recipe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category, productName })
    });

    if (!res.ok) {
      throw new Error(`Server error: ${res.status}`);
    }

    const data = await res.json();
    console.log('✅ Recipe received:', data);
    
    if (data.success && data.content) {
      contentEl.innerHTML = `
        <div class="recipe-content">
          ${formatRecipeContent(data.content)}
        </div>
      `;
    } else {
      throw new Error('No content received');
    }
  } catch (err) {
    console.error('❌ Recipe error:', err);
    contentEl.innerHTML = `
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Failed to load content. Please try again.
        <br><small class="text-muted">${err.message}</small>
      </div>
    `;
  }
}

// Format recipe content (converts plain text to HTML)
function formatRecipeContent(text) {
  if (!text) return '<p class="text-muted">No content available</p>';
  
  // Convert markdown-style formatting to HTML
  let formatted = text
    // Bold text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    // Paragraphs
    .split('\n\n')
    .map(para => {
      // Handle lists
      if (para.includes('\n- ') || para.includes('\n* ')) {
        const items = para.split('\n').filter(line => line.trim());
        const listItems = items
          .filter(item => item.trim().startsWith('-') || item.trim().startsWith('*'))
          .map(item => `<li>${item.replace(/^[\-\*]\s*/, '')}</li>`)
          .join('');
        return `<ul>${listItems}</ul>`;
      }
      // Regular paragraphs
      return `<p>${para.replace(/\n/g, '<br>')}</p>`;
    })
    .join('');
  
  return formatted;
}

// Get Buy Links from Blinkit
async function getBuyLinks(category, productName) {
  console.log('🛒 Fetching buy links for:', productName, category);
  
  const modal = new bootstrap.Modal(document.getElementById('buyLinksModal'));
  const titleEl = document.getElementById('buyTitle');
  const contentEl = document.getElementById('buyLinksContent');

  // Set title and show loading
  titleEl.textContent = `Buy ${productName}`;
  contentEl.innerHTML = `
    <div class="text-center py-5">
      <div class="spinner-border text-warning" role="status"></div>
      <p class="mt-3 text-muted">Finding best prices...</p>
    </div>
  `;

  modal.show();

  try {
    const res = await fetch('/api/blinkit/links', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category, productName })
    });

    if (!res.ok) {
      throw new Error(`Server error: ${res.status}`);
    }

    const data = await res.json();
    console.log('✅ Links received:', data);
    
    if (data.success && data.links) {
      // Parse the links (newline-separated URLs)
      const links = data.links.trim().split('\n').filter(l => l.trim());
      
      const platforms = [
        { name: 'Blinkit', icon: 'bi-lightning-charge-fill', color: '#f8cb46' },
        { name: 'Zepto', icon: 'bi-zap-fill', color: '#c854de' },
        { name: 'BigBasket', icon: 'bi-basket-fill', color: '#84c225' }
      ];
      
      let html = '<div class="d-grid gap-2">';
      
      links.forEach((link, index) => {
        const platform = platforms[index] || { name: 'Store', icon: 'bi-cart', color: '#6366f1' };
        html += `
          <a href="${link}" target="_blank" rel="noopener noreferrer" class="link-card">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <i class="bi ${platform.icon} me-2" style="color: ${platform.color}; font-size: 1.3rem;"></i>
                <strong>${platform.name}</strong>
              </div>
              <i class="bi bi-arrow-right"></i>
            </div>
          </a>
        `;
      });
      
      html += '</div>';
      contentEl.innerHTML = html;
    } else {
      throw new Error('No links received');
    }
    
  } catch (err) {
    console.error('❌ Buy links error:', err);
    contentEl.innerHTML = `
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Failed to load shopping links. Please try again.
        <br><small class="text-muted">${err.message}</small>
      </div>
    `;
  }
}
</script>

</body>
</html>
